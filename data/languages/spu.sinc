HP: "pe" is fbP=1 & fbD=0 & fbE=1 { }
HP: "pd" is fbP=1 & fbD=1 & fbE=0 { }
HP: "pde" is fbP=1 & fbD=1 & fbE=1 { }
SYNCF: is fbP=0 & fbD=0 & fbE=0 { }
SYNCF: "e" is fbP=0 & fbD=0 & fbE=1 { }
SYNCF: "d" is fbP=0 & fbD=1 & fbE=0 { }
SYNCF: "de" is fbP=0 & fbD=1 & fbE=1 { }
SYNCF: "c" is fbP=1 & fbD=0 & fbE=0 { }
SYNCF: "ce" is fbP=1 & fbD=0 & fbE=1 { }
SYNCF: "cd" is fbP=1 & fbD=1 & fbE=0 { }
SYNCF: "cde" is fbP=1 & fbD=1 & fbE=1 { }

# decode-time constants
K0: v is u16 [ v = u16 * 0x0001000100010001; ] { export *[const]:8 v; }
K1: v is u16 [ v = (u16 << 16) * 0x0000000100000001; ] { export *[const]:8 v; }
K2: v is i16 [ v = (i16 & 0xffffffff) * 0x0000000100000001; ] { export *[const]:8 v; }
K3: v is u18 [ v = u18 * 0x0000000100000001; ] { export *[const]:8 v; }
K4: v is u16 [ v = u16 * 0x0000000100000001; ] { export *[const]:8 v; }
K5: v is u16 [ v = (((u16 >> 15) & 1) * 0xff << 56) | (((u16 >> 14) & 1) * 0xff << 48) | (((u16 >> 13) & 1) * 0xff << 40) | (((u16 >> 12) & 1) * 0xff << 32) | (((u16 >> 11) & 1) * 0xff << 24) | (((u16 >> 10) & 1) * 0xff << 16) | (((u16 >> 9) & 1) * 0xff << 8) | (((u16 >> 8) & 1) * 0xff << 0); ] { export *[const]:8 v; }
K6: v is u16 [ v = (((u16 >> 7) & 1) * 0xff << 56) | (((u16 >> 6) & 1) * 0xff << 48) | (((u16 >> 5) & 1) * 0xff << 40) | (((u16 >> 4) & 1) * 0xff << 32) | (((u16 >> 3) & 1) * 0xff << 24) | (((u16 >> 2) & 1) * 0xff << 16) | (((u16 >> 1) & 1) * 0xff << 8) | (((u16 >> 0) & 1) * 0xff << 0); ] { export *[const]:8 v; }
K7: v is i10 [ v = (i10 & 0xff) * 0x101010101010101; ] { export *[const]:8 v; }
K8: v is i10 [ v = (i10 & 0xffff) * 0x1000100010001; ] { export *[const]:8 v; }
K9: v is i10 [ v = (i10 & 0xffffffff) * 0x100000001; ] { export *[const]:8 v; }
K10: v is i7 [ v = i7 & 0x1f; ] { export *[const]:2 v; }
K11: v is i7 [ v = i7 & 0x3f; ] { export *[const]:4 v; }
K12: v is i7 [ v = i7 & 0xf; ] { export *[const]:2 v; }
K13: v is i7 [ v = i7 & 0x1f; ] { export *[const]:4 v; }
K14: v is i7 [ v = (0 - i7) & 0x1f; ] { export *[const]:2 v; }
K15: v is i7 [ v = (0 - i7) & 0x3f; ] { export *[const]:4 v; }
K16: v is i7 [ v = i7 & 0xf; ] { export *[const]:4 v; }
K17: v is i7 [ v = i7 & 7; ] { export *[const]:4 v; }
K18: v is i7 [ v = (0 - i7) & 0x1f; ] { export *[const]:4 v; }
K19: v is i7 [ v = (0 - i7) & 7; ] { export *[const]:4 v; }
K20: v is u8 [ v = ((1023 - (155 - u8)) & 0x7ff) << 52; ] { export *[const]:8 v; }
K21: v is u8 [ v = ((1023 + (173 - u8)) & 0x7ff) << 52; ] { export *[const]:8 v; }

:lqd R0, LSA10(R7) is op8=0x34 & ra_raw=1 & R0 & R7 & LSA10
