define pcodeop spu_stop;         # stop and signal the PPE (signal type)
define pcodeop spu_stopd;        # stop with register dependencies
define pcodeop spu_halt;         # halt instruction condition met

# lqd/stqd displacement: I10 quadwords
LSA10: off is i10 [ off = i10 << 4; ] { export *[const]:4 off; }
# PC-relative and absolute instruction addresses (I16 words), masked by LSLR like the hardware
REL16: addr is i16 [ addr = (inst_start + (i16 << 2)) & 0x3ffff; ] { export *[ram]:4 addr; }
ABS16: addr is u16 [ addr = u16 << 2; ] { export *[ram]:4 addr; }
# lqa/lqr/stqa/stqr: the operand (and its reference) is the encoded word address, which
# compilers set to the scalar being accessed; the access itself ignores the low 4 bits.
QREL16: addr is i16 [ addr = (inst_start + (i16 << 2)) & 0x3ffff; ] { export *[ram]:4 addr; }
QABS16: addr is u16 [ addr = u16 << 2; ] { export *[ram]:4 addr; }
# hint-for-branch: address of the hinted branch instruction
BRI9A: addr is roh & rol [ addr = (inst_start + (((roh << 7) | rol) << 2)) & 0xffffffff; ] { export *[ram]:4 addr; }
BRI9B: addr is rohb & rol [ addr = (inst_start + (((rohb << 7) | rol) << 2)) & 0xffffffff; ] { export *[ram]:4 addr; }

# Feature bits of the indirect branches: P (bit 11), D (12, disable interrupts) and E (13, enable)
FB: is fbP=0 & fbD=0 & fbE=0 { }
FB: "e" is fbP=0 & fbD=0 & fbE=1 { IE = 1; }
FB: "d" is fbP=0 & fbD=1 & fbE=0 { IE = 0; }
FB: "de" is fbP=0 & fbD=1 & fbE=1 {  }
FB: "p" is fbP=1 & fbD=0 & fbE=0 {  }
FB: "pe" is fbP=1 & fbD=0 & fbE=1 { IE = 1; }
FB: "pd" is fbP=1 & fbD=1 & fbE=0 { IE = 0; }
FB: "pde" is fbP=1 & fbD=1 & fbE=1 {  }
HP: is fbP=0 & fbD=0 & fbE=0 { }
HP: "e" is fbP=0 & fbD=0 & fbE=1 { }
HP: "d" is fbP=0 & fbD=1 & fbE=0 { }
HP: "de" is fbP=0 & fbD=1 & fbE=1 { }
