	local sh:4 = (15 - t) * 8;
	local base:16 = (zext(0x1011121314151617:8) << 64) | zext(0x18191a1b1c1d1e1f:8);
	R0 = (base & ~(zext(0xff:8) << sh)) | (zext(0x03:8) << sh);
}

